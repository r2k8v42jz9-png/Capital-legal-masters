# ─────────────────────────────────────────────────────────────────────────────
# Capital Legal Masters — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Gmail SMTP credentials for contact form emails
# 1. Use your Gmail address (the sender account)
# 2. Use a Gmail App Password — NOT your regular Gmail password.
#    Generate at: https://myaccount.google.com/apppasswords
#    (requires 2-Step Verification to be enabled on your Google account)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
